# Database Configuration
# Option 1: Use individual components
DB_HOST=localhost
DB_PORT=3306
DB_USER=fantasy_user
DB_PASSWORD=fantasy_password
DB_NAME=fantasy_football

# Option 2: Use full database URL (overrides individual components)
# DATABASE_URL=mysql+pymysql://fantasy_user:fantasy_password@localhost:3306/fantasy_football?charset=utf8mb4

# Database debugging (set to true to enable SQL query logging)
DB_ECHO=false

# Sleeper API Configuration
SLEEPER_LEAGUE_ID=your_league_id_here
SLEEPER_USER_ID=your_user_id_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: External API keys
# NFL_API_KEY=your_nfl_api_key
# FANTASY_PROS_API_KEY=your_fantasy_pros_api_key